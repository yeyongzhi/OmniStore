{
  "name": "omni-storage-kit",
  "version": "1.0.0",
  "description": "A typed unified browser storage toolkit for localStorage, sessionStorage, IndexedDB, and cookies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeyongzhi/OmniStore.git"
  },
  "homepage": "https://yeyongzhi.github.io/OmniStore/",
  "bugs": {
    "url": "https://github.com/yeyongzhi/OmniStore/issues"
  },
  "keywords": [
    "storage",
    "localstorage",
    "sessionstorage",
    "indexeddb",
    "cookie",
    "typescript"
  ],
  "license": "MIT",
  "author": "Aurora",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "tsup src/index.ts --format iife --global-name OmniStorageKit --out-dir .tmp-browser-test --clean && playwright test",
    "check": "pnpm typecheck && pnpm test:coverage && pnpm test:browser && pnpm build && pnpm docs:build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "fake-indexeddb": "^6.2.2",
    "happy-dom": "^18.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  }
}
